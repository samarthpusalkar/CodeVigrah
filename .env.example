# CodeVigrah configuration. Copy to `.env` (which git ignores) and uncomment what you need.
# Every setting is optional: with no configuration CodeVigrah runs privately on http://127.0.0.1:8765.
# Real environment variables take precedence over this file. Never commit real keys.

# ---------------------------------------------------------------- server
# CODEVIGRAH_HOST=127.0.0.1             # 0.0.0.0 = reachable from other devices on your network
# CODEVIGRAH_PORT=8765
# CODEVIGRAH_WORKSPACE=workspace        # clones, analyses and cached AI output
# CODEVIGRAH_LOG_LEVEL=INFO

# ---------------------------------------------------------------- hosting for other people (see docs/deployment.md)
# CODEVIGRAH_PUBLIC=1                   # lock AI settings, refuse local folders, enable the rate limits below
# CODEVIGRAH_ALLOWED_HOSTS=codevigrah.example.com
# CODEVIGRAH_TRUST_PROXY=1              # only behind your own reverse proxy or tunnel (reads X-Forwarded-For)
# CODEVIGRAH_RATE_AI_PER_HOUR=30        # per visitor IP; defaults to 30 when public, unlimited otherwise
# CODEVIGRAH_RATE_ANALYZE_PER_HOUR=10   # per visitor IP; defaults to 10 when public, unlimited otherwise
# CODEVIGRAH_RATE_TTS_PER_HOUR=600      # sentences voiced fresh per visitor IP (cached ones are free); 600 when public
# CODEVIGRAH_MAX_JOBS=2                 # analyses running at the same time
# CODEVIGRAH_MAX_REPO_MB=1000           # bigger clones are rejected
# CODEVIGRAH_CLONE_DEPTH=1000           # commits of history to fetch
# CODEVIGRAH_ALLOW_LOCAL_PATHS=1        # allow local folders when listening on the network (never in public mode)

# ---------------------------------------------------------------- AI providers (see docs/ai-providers.md)
# Order to try them in; the next one takes over when one fails. `auto` = every configured provider, in this order:
# anthropic, claude-cli, ollama, groq, openai (a public instance skips claude-cli unless you list it). `off` = no AI.
# CODEVIGRAH_AI_PROVIDERS=auto
# CODEVIGRAH_AI_CONTEXT_CHARS=60000     # source excerpts pasted for providers that cannot open files themselves

# Claude Code on this machine (install it and log in; it reads the repo itself with read-only tools)
# CODEVIGRAH_CLAUDE_BIN=claude
# CODEVIGRAH_CLAUDE_MODEL=              # blank = Claude Code's default
# CODEVIGRAH_CLAUDE_TIMEOUT=420
# CODEVIGRAH_CLAUDE_CONCURRENCY=2

# Anthropic API (needs: pip install "codevigrah[anthropic]")
# ANTHROPIC_API_KEY=
# CODEVIGRAH_ANTHROPIC_MODEL=claude-opus-5-5
# CODEVIGRAH_ANTHROPIC_EFFORT=high      # low | medium | high | xhigh | max; empty for models without effort control
# CODEVIGRAH_ANTHROPIC_FALLBACKS=1      # retry refusals server-side on Anthropic's recommended fallback model
# CODEVIGRAH_ANTHROPIC_MAX_TOKENS=32000

# Ollama: a local model, on this machine or another one (e.g. a GPU box: http://gpu-box.local:11434/v1)
# CODEVIGRAH_OLLAMA_BASE_URL=http://localhost:11434/v1
# CODEVIGRAH_OLLAMA_MODEL=qwen2.5-coder:14b
# CODEVIGRAH_OLLAMA_TIMEOUT=900
# CODEVIGRAH_OLLAMA_CONCURRENCY=1

# Groq: hosted open models with a free tier (key from https://console.groq.com)
# GROQ_API_KEY=
# CODEVIGRAH_GROQ_MODEL=
# CODEVIGRAH_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Any other OpenAI-compatible server: LM Studio, vLLM, llama.cpp, OpenRouter, OpenAI, ...
# CODEVIGRAH_OPENAI_BASE_URL=http://localhost:1234/v1
# CODEVIGRAH_OPENAI_API_KEY=            # or OPENAI_API_KEY
# CODEVIGRAH_OPENAI_MODEL=

# ---------------------------------------------------------------- read-aloud (see docs/speech.md)
# Without a speech server the browser speaks with the device's own voices. With one, natural voices are made here.
# CODEVIGRAH_TTS_BASE_URL=http://127.0.0.1:8880/v1   # contrib/speech-server, Kokoro-FastAPI, Speaches, OpenAI, ...
#   several servers, fastest first; one that does not answer is skipped for a minute:
#   CODEVIGRAH_TTS_BASE_URL=http://my-mac.local:8880/v1,http://127.0.0.1:8880/v1
# CODEVIGRAH_TTS_API_KEY=
# CODEVIGRAH_TTS_MODEL=kokoro
# CODEVIGRAH_TTS_VOICE=af_heart         # default voice
# CODEVIGRAH_TTS_VOICES=                # comma-separated voices to offer (needed for servers without a voice list)
# CODEVIGRAH_TTS_FORMAT=mp3
# CODEVIGRAH_TTS_TIMEOUT=120
# CODEVIGRAH_TTS_CONCURRENCY=1          # raise for a GPU speech server
# CODEVIGRAH_TTS_PREPARE=0              # 1 = voice tour chapters in the background so playback never waits
# CODEVIGRAH_LISTEN_SCRIPTS=1           # AI listening scripts for tour chapters (one extra AI call per chapter, cached)
